<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Uprawnienia -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/CyrkNaKółkach"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"

        tools:targetApi="31">

        <!-- Główna aktywność logowania -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:theme="@style/CyrkNaKółkach.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Aktywność rejestracji -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".activities.LoginActivity"
            android:theme="@style/CyrkNaKółkach.NoActionBar" />

        <!-- Aktywność testowania API -->
        <activity
            android:name=".activities.TestApiActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/CyrkNaKółkach" />

        <!-- Główna aktywność aplikacji -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/CyrkNaKółkach" />

    </application>

</manifest>